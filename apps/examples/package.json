{
  "name": "examples",
  "version": "0.0.0",
  "private": true,
  "description": "Next.js App Router playground and documentation site for the @videoglow packages.",
  "scripts": {
    "dev": "next dev",
    "build": "node ../../tools/scripts/sync-storybook.mjs && next build",
    "start": "next start",
    "typecheck": "next typegen && tsc -p tsconfig.json",
    "lint": "eslint -c ../../eslint.config.mjs .",
    "og:generate": "node scripts/generate-og-image.mts"
  },
  "dependencies": {
    "@videoglow/canvas": "workspace:^",
    "@videoglow/core": "workspace:^",
    "@videoglow/react": "workspace:^",
    "@videoglow/react-video": "workspace:^",
    "@videoglow/react-youtube": "workspace:^",
    "@videoglow/video": "workspace:^",
    "@videoglow/youtube": "workspace:^",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.7",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-ambilight": "workspace:^",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.0",
    "simple-icons": "^16.33.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3"
  },
  "nx": {
    "tags": [
      "layer:app"
    ],
    "targets": {
      "build": {
        "dependsOn": [
          "^build",
          "storybook:build-storybook"
        ],
        "outputs": [
          "{projectRoot}/.next",
          "{projectRoot}/public/storybook"
        ]
      },
      "dev": {
        "dependsOn": [
          "^build"
        ]
      },
      "start": {
        "dependsOn": [
          "build"
        ]
      }
    },
    "implicitDependencies": [
      "storybook"
    ]
  }
}

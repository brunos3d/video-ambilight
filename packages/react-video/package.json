{
  "name": "@videoglow/react-video",
  "version": "2.0.0",
  "description": "VideoAmbilight React component and useVideoSource hook for native HTML video.",
  "license": "MIT",
  "author": "Bruno Silva <foss@brunosilva.io>",
  "homepage": "https://github.com/brunos3d/video-ambilight#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brunos3d/video-ambilight.git",
    "directory": "packages/react-video"
  },
  "keywords": [
    "ambilight",
    "glow",
    "react",
    "video",
    "effect",
    "nextjs"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint -c ../../eslint.config.mjs ."
  },
  "dependencies": {
    "@videoglow/core": "workspace:^",
    "@videoglow/react": "workspace:^",
    "@videoglow/video": "workspace:^"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "tags": [
      "layer:react-source"
    ]
  }
}

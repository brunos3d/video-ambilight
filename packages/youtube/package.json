{
  "name": "@videoglow/youtube",
  "version": "2.0.0",
  "description": "YouTube IFrame Player integration for @videoglow: typed API loader, player controller and leader/follower playback synchronization.",
  "license": "MIT",
  "author": "Bruno Silva <foss@brunosilva.io>",
  "homepage": "https://github.com/brunos3d/video-ambilight#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brunos3d/video-ambilight.git",
    "directory": "packages/youtube"
  },
  "keywords": [
    "ambilight",
    "glow",
    "youtube",
    "iframe-api",
    "youtube-player",
    "sync"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint -c ../../eslint.config.mjs ."
  },
  "dependencies": {
    "@videoglow/core": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "tags": [
      "layer:source"
    ]
  }
}
